# Committed on purpose: NEXT_PUBLIC_* values are inlined into the client bundle
# at build time, so they are public by definition — there is no secret here.
# This is the default the Docker image builds with; override it per-build with
#   docker build --build-arg API_URL=https://other-host ...
NEXT_PUBLIC_API_URL=https://clash-1-0-0.onrender.com
